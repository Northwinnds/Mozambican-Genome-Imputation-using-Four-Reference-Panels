# Projection PCA - using 1kGPB-c reference panel
# Description:
#   Projects imputed low-coverage target samples onto PCs computed from the
#   1kGPAB-c reference panel (1kGP African subset + Bantu dataset).
#   PC1 is flipped to match joint PCA orientation and the geographical
#   layout of African populations.
#   Includes PC1 offset calculation.
#
# Note:
#   Projection PCA showed a systematic PC1 offset between imputed dosage
#   values (0-2) and reference hard calls (0, 1 and 2).
#
# Citation:
#   Refer to the reference list. 
#
# Input files:
#   <afr_eigenvec>.eigenvec  - PLINK2 eigenvec from African reference-only PCA
#   <afr_eigenval>.eigenval  - PLINK2 eigenval from African reference-only PCA
#   <proj_sscore>.sscore     - PLINK2 sscore from projected imputed samples
#   <afr_metadata>.txt       - African population metadata: IID, Population

library(ggplot2)

# User settings
setwd("<working_directory>")
afr_eigenvec_file <- "<afr_eigenvec>.eigenvec"
afr_eigenval_file <- "<afr_eigenval>.eigenval"
proj_sscore_file  <- "<proj_sscore>.sscore"
afr_metadata_file <- "<afr_metadata>.txt"
output_plot       <- "<output_plot>.png"
target_in_ref     <- c("<sample_id_1>", "<sample_id_2>")
target_prefix     <- "^moz"
imputed_label     <- "MOZ_imputed"

# Load African reference PCA eigenvectors and eigenvalues generated from PLINK2
ref_afr <- read.table(afr_eigenvec_file, header=FALSE, skip=1)
colnames(ref_afr) <- c("IID", paste0("PC", 1:10))
eigenval_afr <- read.table(afr_eigenval_file)
pct_afr <- round(eigenval_afr / sum(eigenval_afr) * 100, 1)

# Load projected imputed sample scores
# PLINK2 sscore: col1=IID, col2=ALLELE_CT, col3=DOSAGE_SUM, col4-13=PC1-10
proj_afr <- read.table(proj_sscore_file, header=TRUE, comment.char="")
colnames(proj_afr)[1]    <- "IID"
colnames(proj_afr)[4:13] <- paste0("PC", 1:10)
proj_afr <- proj_afr[, c("IID", paste0("PC", 1:10))]

# Label reference groups 
# Also to distinguish between Mozambique cohorts from imputed vs reference
ref_afr$group <- ifelse(
  grepl(target_prefix, ref_afr$IID) & !ref_afr$IID %in% target_in_ref,
  "Mozambican", "Reference"
)

# Load African population affiliation data (columns: IID, Population)
afr_meta <- read.table(afr_metadata_file, header=FALSE)
colnames(afr_meta) <- c("IID", "Population")
afr_meta$Population[afr_meta$Population == "Bantu_Cabinda"]    <- "CAB"
afr_meta$Population[afr_meta$Population == "Bantu_Mozambique"] <- "MOZ"

# Merge reference with affiliation data
ref_afr_meta <- merge(ref_afr, afr_meta, by="IID", all.x=TRUE)
ref_afr_meta$Population[ref_afr_meta$group == "Mozambican"] <- "MOZ"
ref_afr_meta$group <- "Reference"

# Add imputed sample labels
proj_afr$Population <- imputed_label
proj_afr$group      <- "Mozambican"

# Combine reference and projected samples
combined_afr <- rbind(
  ref_afr_meta[, c("IID","PC1","PC2","Population","group")],
  proj_afr[,    c("IID","PC1","PC2","Population","group")]
)

# Flip PC1 to match joint PCA orientation
# Also to reflect as much as possible georaphical map of the populations 
combined_afr$PC1 <- -combined_afr$PC1

# Print sample counts and PC1 and PC2 variance explained
cat("Sample counts:\n")
print(table(combined_afr$group))
cat("PC1:", pct_afr[1,], "% | PC2:", pct_afr[2,], "%\n")

# Calculate PC1 offset between reference and imputed samples
ref_pc1 <- mean(combined_afr$PC1[combined_afr$group == "Reference"])
imp_pc1 <- mean(combined_afr$PC1[combined_afr$group == "Mozambican"])
cat("PC1 offset (imputed - reference):", round(imp_pc1 - ref_pc1, 4), "\n")

# Factor order for legend
combined_afr$Population <- factor(
  combined_afr$Population,
  levels = c("GWD","MSL","YRI","ESN","LWK","CAB","MOZ", imputed_label)
)

# Colour palette
cols_afr <- c(
  "YRI"         = "blue",
  "GWD"         = "red",
  "MSL"         = "darkorange",
  "ESN"         = "green",
  "LWK"         = "darkorchid1",
  "CAB"         = "deeppink",
  "MOZ"         = "deepskyblue1",
  "MOZ_imputed" = "black"
)

# Plot
p2 <- ggplot(combined_afr, aes(x=PC1, y=PC2, colour=Population)) +
  geom_point(
    data  = combined_afr[combined_afr$Population != imputed_label, ],
    size  = 2, alpha = 0.7, shape = 19
  ) +
  geom_point(
    data  = combined_afr[combined_afr$Population == imputed_label, ],
    size  = 2.5, alpha = 0.9, shape = 19
  ) +
  scale_colour_manual(values=cols_afr) +
  labs(
    x = paste0("PC1 (", pct_afr[1,], "%)"),
    y = paste0("PC2 (", pct_afr[2,], "%)"),
    colour = ""
  ) +
  theme_bw() +
  theme(
    panel.grid.major  = element_line(colour="grey90"),
    panel.grid.minor  = element_blank(),
    legend.position   = "right",
    legend.title      = element_blank(),
    legend.text       = element_text(size=11),
    legend.key        = element_blank(),
    legend.background = element_blank(),
    axis.title        = element_text(size=12),
    axis.text         = element_text(size=10)
  ) +
  guides(colour=guide_legend(override.aes=list(size=4, alpha=1)))

print(p2)
ggsave(output_plot, plot=p2, width=10, height=8, dpi=300)
cat("Plot saved to", output_plot, "\n")
